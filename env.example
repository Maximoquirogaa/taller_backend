# Archivo de ejemplo: todas las variables que lee app/core/config.py.
# COPIAR A .env (excluido de versionado) y COMPLETAR los valores marcados con = vacío.
# Nunca commitear un .env ni poner secretos reales acá.

# ── Base de datos (PostgreSQL 16) ──────────────────────────────────────
POSTGRES_USER=taller
POSTGRES_PASSWORD=
POSTGRES_DB=taller
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POOL_SIZE=5

# ── Seguridad (solo entorno; sin defaults en el código → si faltan, la app no arranca) ──
SECRET_KEY=
BCRYPT_COST=12
TOKEN_EXPIRE_SEGUNDOS=1800
COOKIE_SECURE=false

# ── Diagnóstico ────────────────────────────────────────────────────────
SQL_ECHO=false

# ── Cómo completarlo ───────────────────────────────────────────────────
# 1) POSTGRES_PASSWORD: la contraseña del usuario de la base (no la deje vacía).
# 2) SECRET_KEY: generar una firma nueva con
#       python -c "import secrets; print(secrets.token_urlsafe(64))"
# 3) Desarrollo local: SQL_ECHO=true para ver las consultas en la consola.
# 4) COOKIE_SECURE=false en dev (http); true detrás de https.
